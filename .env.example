# Local development example only.
# Production must provide a real DJANGO_SECRET_KEY through its environment.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-development-only-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=replace-with-dify-api-key
DIFY_TIMEOUT_SECONDS=30
AGENT_TOOL_API_TOKEN=replace-with-a-random-server-to-server-token
# Render supplies this automatically; set DJANGO_DEBUG=false in production.
RENDER_EXTERNAL_HOSTNAME=your-service.onrender.com
PYTHON_VERSION=3.14.3
